<?xml version="1.0" encoding="utf-8" ?>
<Window x:Class="Sungaila.SoundReaver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Sungaila.SoundReaver.Converters"
        xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ext="using:Sungaila.SoundReaver.Extensions"
        xmlns:local="using:Sungaila.SoundReaver"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:v="using:Sungaila.SoundReaver.Views"
        xmlns:vm="using:Sungaila.SoundReaver.ViewModels"
        Title="Sound Reaver"
        mc:Ignorable="d">
    <Window.SystemBackdrop>
        <local:MicaTintedBackdrop Alpha="60" />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <canvas:CanvasControl x:Name="PatternCanvasHorizontal"
                              Grid.Row="0"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              AutomationProperties.AccessibilityView="Raw"
                              CreateResources="PatternCanvas_CreateResources"
                              Draw="PatternCanvas_Draw"
                              IsHitTestVisible="False"
                              Opacity="0.2" />

        <canvas:CanvasControl x:Name="PatternCanvasVertical"
                              Grid.Row="1"
                              Width="50"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Stretch"
                              AutomationProperties.AccessibilityView="Raw"
                              CreateResources="PatternCanvas_CreateResources"
                              Draw="PatternCanvas_Draw"
                              IsHitTestVisible="False"
                              Opacity="0.2"
                              Visibility="{x:Bind PatternCanvasHorizontal.Visibility, Mode=OneWay}" />

        <v:AppTitleBar x:Name="AppTitleBar"
                       Title="{x:Bind Title, Mode=OneTime}"
                       Grid.Row="0" />

        <v:MainView x:Name="MainView" Grid.Row="1" />
    </Grid>
</Window>
